OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_DB_PATH=data/memories.db
MEMORY_TOP_K=5
MEMORY_CANDIDATE_LIMIT=20
MEMORY_HALF_LIFE_DAYS=30

# Security / input validation
# External sharing: use one private app access code (16+ chars).
APP_ACCESS_TOKEN=
ADMIN_API_TOKEN=
RATE_LIMIT_PER_MINUTE=20
IP_RATE_LIMIT_PER_MINUTE=60
MESSAGE_MAX_CHARS=4000
MESSAGE_MAX_SAME_CHAR_RUN=100
MESSAGE_MAX_URLS=10
REPLACEMENT_CHAR_RATIO=0.20
IDEMPOTENCY_TTL_SECONDS=300

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
LOG_PATH=logs/character-memory.jsonl
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7
LOG_INCLUDE_CONTENT=false
# Optional override. If omitted, a stable salt is derived from ADMIN_API_TOKEN.
# LOG_HASH_SALT=
